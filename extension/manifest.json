{
  "manifest_version": 3,
  "name": "VerloskundigeSpiekt templates",
  "version": "0.1.0",
  "description": "Uses authorized published practice templates; substitution data remains local.",
  "permissions": ["clipboardWrite", "storage"],
  "host_permissions": ["https://api.verloskundigespiekt.nl/*", "https://identitytoolkit.googleapis.com/*", "https://securetoken.googleapis.com/*"],
  "action": { "default_title": "VerloskundigeSpiekt", "default_popup": "popup.html" },
  "background": { "service_worker": "background.js", "type": "module" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" }
}
